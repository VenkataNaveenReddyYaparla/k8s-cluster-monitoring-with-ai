# Copy this file to .env and fill in real values. Never commit .env.

# --- Prometheus ---------------------------------------------------------
PROMETHEUS_URL=http://prometheus.example.com

# --- Google Gemini (AI summary, free tier) ------------------------------
GEMINI_API_KEY=put_your_gemini_api_key_here
# "auto" tries a ranked list of current Flash models and falls back on
# failure. Set an explicit model name (e.g. gemini-2.5-flash) to pin one.
GEMINI_MODEL=auto
# Max data rows kept per PromQL query when building the prompt, to keep it small.
MAX_ROWS_PER_QUERY=30

# --- SMTP / email delivery ----------------------------------------------
# SMTP_SERVER accepts one host or a comma-separated list of "host[:port]"
# entries; each is tried in order until one send succeeds, so you can
# configure a primary and one or more backup relays.
#
#   Single internal relay, no auth, no encryption (typical in-cluster relay):
#     SMTP_SERVER=127.0.0.1
#     SMTP_PORT=25
#     SMTP_SECURITY=none
#     # leave SMTP_USER / SMTP_PASS unset
#
#   Authenticated provider over STARTTLS (e.g. Gmail, Office365):
#     SMTP_SERVER=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_SECURITY=starttls
#     SMTP_USER=you@gmail.com
#     SMTP_PASS=your-app-password
#
#   Authenticated provider over implicit TLS/SSL (e.g. port 465):
#     SMTP_SERVER=smtp.example.com
#     SMTP_PORT=465
#     SMTP_SECURITY=ssl
#     SMTP_USER=alerts@example.com
#     SMTP_PASS=your-password
#
#   Primary + fallback relay, both unauthenticated:
#     SMTP_SERVER=mail1.internal.local,mail2.internal.local:2525
#
# SMTP_USER and SMTP_PASS must both be set, or both left unset -- there is
# no partial-auth mode.
SMTP_SERVER=127.0.0.1
SMTP_PORT=25
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASS=

EMAIL_USER=monitor@example.com
EMAIL_TO=recipient1@example.com,recipient2@example.com

# --- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
# When true, collects metrics and generates the summary but does not send email.
DRY_RUN=false
